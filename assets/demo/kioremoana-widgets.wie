{"sidebar-1":{"nav_menu-2":{"title":"","nav_menu":7},"kioremoana_about-2":{"title":"About Me","imageurl":"http:\/\/themes.elmastudio.de\/kioremoana\/files\/2013\/09\/ellen.jpg","imagewidth":"320","imageheight":"320","aboutsubtitle":"Welcome to my Personal Blog","abouttext":"Hello, I'm Ellen and this is my personal blog to write about recent travels, random thoughts, post some photography, quotes I want to save & videos or audio tracks I like. When not blogging or working on new theme creations for our little <a href=\"http:\/\/www.elmastudio.de\/\">Elmastudio<\/a> I love to travel and explore new places, food and meet new people. I especially love Asia and my favorite place to live is New Zealand."},"kioremoana_sociallinks-2":{"title":"Find me on","twitter":"#","facebook":"#","googleplus":"#","appnet":"#","flickr":"#","instagram":"#","picasa":"#","fivehundredpx":"#","youtube":"#","vimeo":"#","dribbble":"#","ffffound":"#","pinterest":"#","behance":"#","deviantart":"#","squidoo":"#","slideshare":"#","lastfm":"#","grooveshark":"#","soundcloud":"#","foursquare":"#","github":"#","linkedin":"#","xing":"#","wordpress":"#","tumblr":"#","rss":"#","rsscomments":"#"},"recent-posts-2":{"title":"","number":5},"recent-comments-2":{"title":"","number":5},"search-2":{"title":"Search This Site"},"kioremoana_flickr-2":{"title":"Flickr Pics","id":"38335866@N08","number":"8","type":"user","sorting":"latest"}},"sidebar-2":{"kioremoana_headerslogan-2":{"slogantitle":"Welcome to the Kiore Moana Theme","slogantext":"Kiore Moana is the perfect little WordPress theme to publish your personal content in a unique & beautiful way."}}}